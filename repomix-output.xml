                <h1>VeriLens: A Multi-Modal AI Framework for Image Provenance and Contextual Verification</h1>
                
                <figure class="blog-figure" style="margin-top: 1.5rem; margin-bottom: 1rem;">
                    <img class="figure-img" src="verilens/addcontext.png" alt="VeriLens Interface Banner">
                </figure>

                <div class="project-links">
                    <a href="https://github.com/hachln/VerilensAI" target="_blank" class="btn-primary"><i class="fab fa-github"></i> Source Code</a>
                    <a href="verilens/Verilens_Paper.pdf" target="_blank" class="btn-secondary"><i class="fa-solid fa-file-pdf"></i> Read Paper</a>
                </div>
            </div>
