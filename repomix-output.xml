    <!-- Chart.js Rendering Logic -->
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            // Shared config for styling
            const chartOptions = {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { labels: { color: '#d3c6aa', font: { family: 'JetBrains Mono' } } } },
                scales: {
                    x: { display: false },
                    y: { display: false }
                },
                elements: { point: { radius: 0 } }
            };

            // 1. Pitch Chart
            const ctxPitch = document.getElementById('pitchChart').getContext('2d');
            const xValues = Array.from({length: 200}, (_, i) => i * 0.1);
            new Chart(ctxPitch, {
                type: 'line',
                data: {
                    labels: xValues,
                    datasets: [
                        { label: 'Low Pitch', data: xValues.map(x => Math.sin(x) + 2.5), borderColor: '#7fbbb3', borderWidth: 2, tension: 0.4 },
                        { label: 'High Pitch', data: xValues.map(x => Math.sin(4*x) - 0.5), borderColor: '#e67e80', borderWidth: 2, tension: 0.4 }
                    ]
                },
                options: chartOptions
            });

            // 2. Modulation Chart
            const ctxMod = document.getElementById('modChart').getContext('2d');
            new Chart(ctxMod, {
                type: 'line',
                data: {
                    labels: xValues,
                    datasets: [
                        { label: 'Modulator (LFO)', data: xValues.map(x => Math.sin(x) + 2.5), borderColor: '#7fbbb3', borderDash: [5, 5], borderWidth: 2, tension: 0.4 },
                        { label: 'Modulated Audio', data: xValues.map(x => Math.sin(12*x + 2.5*Math.sin(x)) - 1), borderColor: '#e67e80', borderWidth: 2, tension: 0.4 }
                    ]
                },
                options: chartOptions
            });

            // 3. Cadence Chart (Represented with Bar bursts)
            const ctxCadence = document.getElementById('cadenceChart').getContext('2d');
            const cadenceX = Array.from({length: 100}, (_, i) => i);
            new Chart(ctxCadence, {
                type: 'bar',
                data: {
                    labels: cadenceX,
                    datasets: [
                        {
                            label: 'Fast Cadence',
                            data: cadenceX.map(x => (x % 20 < 10) ? 1.5 : 0),
                            backgroundColor: 'rgba(127, 187, 179, 0.6)'
                        },
                        {
                            label: 'Slow Cadence',
                            data: cadenceX.map(x => (x % 50 < 15) ? -1.5 : 0),
                            backgroundColor: 'rgba(230, 126, 128, 0.6)'
                        }
                    ]
                },
                options: chartOptions
            });

            // 4. Envelope Chart
            const ctxEnv = document.getElementById('envChart').getContext('2d');
            const envX = Array.from({length: 300}, (_, i) => i * 0.03);
            new Chart(ctxEnv, {
                type: 'line',
                data: {
                    labels: envX,
                    datasets: [
                        {
                            label: 'Envelope Outline (Attack/Decay)',
                            data: envX.map(x => x <= 1.5 ? x/1.5 : (x > 1.5 && x < 8 ? 1 - (x-1.5)/6.5 : 0)),
                            borderColor: '#a7b8a7',
                            borderDash: [5, 5],
                            borderWidth: 2,
                            tension: 0
                        },
                        {
                            label: 'Shaped Audio',
                            data: envX.map(x => {
                                let env = x <= 1.5 ? x/1.5 : (x > 1.5 && x < 8 ? 1 - (x-1.5)/6.5 : 0);
                                return env * Math.sin(40*x);
                            }),
                            borderColor: '#e67e80',
                            borderWidth: 2,
                            tension: 0.1
                        }
                    ]
                },
                options: chartOptions
            });
        });
    </script>
</body>
